{
  "expo": {
    "name": "Rollo",
    "slug": "rollo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.juanifraga.rollo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.juanifraga.rollo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rollo usa la cámara para sacar las fotos y videos del viaje.",
          "microphonePermission": "Rollo usa el micrófono para el sonido de los videos.",
          "photosPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rollo guarda dónde sacaste cada foto para el mapa del viaje."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "scheme": "rollo",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://rollo-api.juanifraga.com"
    }
  }
}
