{
  "name": "rollo-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/hero.*"]
  },
  "routes": [{ "pattern": "rollo.juanifraga.com", "custom_domain": true }]
}
