{
  "name": "rollo-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.21",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "burnt": "^0.13.0",
    "expo": "~58.0.14",
    "expo-audio": "~58.0.10",
    "expo-background-task": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.18",
    "expo-media-library": "~58.0.11",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.18",
    "expo-video": "~58.0.12",
    "expo-video-thumbnails": "~58.0.2",
    "fast-png": "^8.0.0",
    "openapi-fetch": "^0.17.0",
    "piexifjs": "^1.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-pulsar": "^1.7.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "esbuild": "0.28.2",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "marked": "^18.1.1",
    "motion": "14.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "site:build": "node scripts/build-site.mjs",
    "site:deploy": "npm run site:build && npx wrangler@4 deploy --config site/wrangler.jsonc",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs",
    "og": "node scripts/build-og.mjs",
    "update:production": "APP_VARIANT=production EXPO_PUBLIC_API_URL=https://rollo-api.juanifraga.com npx eas-cli@latest update --channel production --environment production --platform ios",
    "api:generate": "openapi-typescript ${API_SPEC:-https://raw.githubusercontent.com/rollo-app/backend/develop/openapi.json} --default-non-nullable false -o src/api/schema.d.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|openapi-fetch|standard-navigation|fast-png|iobuffer|pako)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
